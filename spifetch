def text_points(word, rgb=(120, 170, 230)):
    word = "".join(ch for ch in word.upper() if ch in FONT)[:8] or "LINUX"
    cells = {}
    for i, ch in enumerate(word):
        for y, line in enumerate(FONT[ch]):
            for x, bit in enumerate(line):
                if bit == "1":
                    cells[(i * 6 + x, y)] = (rgb, 1.0)
    return extrude(cells, 1.0, 1.0), rgb


def extrude(cells, sx, sy):
    """Turn a 2D grid of coloured cells into front/back faces + side walls with normals.
    cells: {(gx, gy): ((r, g, b), half_depth)}  ->  list of (x, y, z, nx, ny, nz, palette_index), palette"""
    palette, pindex = [], {}
    xs = [gx for gx, _ in cells]
    ys = [gy for _, gy in cells]
    cx, cy = (min(xs) + max(xs)) / 2, (min(ys) + max(ys)) / 2
    sub = 2 if sx <= 1 else 1           # supersample coarse grids so no holes appear
    pts = []
    for (gx, gy), (rgb, d) in cells.items():
        if rgb not in pindex:
            pindex[rgb] = len(palette)
            palette.append(rgb)
        p = pindex[rgb]
        for ix in range(sub):
            for iy in range(sub):
                x = (gx - cx + ix / sub) * sx
                y = (gy - cy + iy / sub) * sy
                pts.append((x, y, -d, 0.0, 0.0, -1.0, p))
                pts.append((x, y, d, 0.0, 0.0, 1.0, p))
        x0, y0 = (gx - cx) * sx, (gy - cy) * sy
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nb = cells.get((gx + dx, gy + dy))
            nd = nb[1] if nb else 0.0
            if nd >= d:
                continue
            zstep = min(sx, sy) / sub
            z = nd
            while z <= d + 1e-9:
                for t in range(sub):
                    off = (t / sub - 0.5)
                    px = x0 + (dx * 0.5 * sx if dx else off * sx)
                    py = y0 + (dy * 0.5 * sy if dy else off * sy)
                    for sz in (-1, 1):
                        pts.append((px, py, sz * z, float(dx), float(dy), 0.0, p))
                z += zstep
    return pts, palette


# ============================================================== renderer
def render(points, palette, accent, title, info, speed, show_info):
    if IS_WIN:
        os.system("")  # turn on ANSI colours in the Windows console
        try:
            sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass
    radius = max(math.sqrt(x * x + y * y + z * z) for x, y, z, *_ in points) or 1.0
    light = (-0.45, -0.55, -0.70)
    ln = math.sqrt(sum(c * c for c in light))
    lx, ly, lz = (c / ln for c in light)
    nchars = len(CHARS) - 1
    ar, ag, ab = accent
    key_col = f"\x1b[1;38;2;{ar};{ag};{ab}m"
    info_lines = [f"{key_col}{title}\x1b[0m", "\x1b[38;2;120;120;120m" + "-" * len(title) + "\x1b[0m"]
    info_lines += [f"{key_col}{k}\x1b[0m: {v}" for k, v in info]
    info_lines += ["", "".join(f"\x1b[38;2;{r};{g};{b}m███" for r, g, b in palette[:8]) + "\x1b[0m"]
    info_w = max([len(title)] + [len(k) + 2 + len(v) for k, v in info]) + 4 if show_info else 0

    sys.stdout.write("\x1b[?25l\x1b[2J")
    start = time.time()
    try:
        while True:
            cols, rows = shutil.get_terminal_size((100, 40))
            h = max(10, rows - 1)
            w = max(20, cols - info_w) if show_info and cols - info_w >= 30 else cols
            show = show_info and w < cols
            k2 = radius * 3.0
            scale = min(h * 0.92, w / 2 * 0.92) / (2 * radius)
            k1 = scale * (k2 - radius)
            cx, cy = w / 2, h / 2

            t = time.time() - start
            a, b = t * speed, 0.25 * math.sin(t * 0.7)
            ca, sa, cb, sb = math.cos(a), math.sin(a), math.cos(b), math.sin(b)
            zbuf = [0.0] * (w * h)
            out = [" "] * (w * h)
            col = [-1] * (w * h)
            for x, y, z, nx, ny, nz, p in points:
                x1 = x * ca + z * sa
                z1 = -x * sa + z * ca
                y2 = y * cb - z1 * sb
                z2 = y * sb + z1 * cb
                ooz = 1.0 / (z2 + k2)
                sx = int(cx + k1 * x1 * ooz * 2)
                sy = int(cy + k1 * y2 * ooz)
                if not (0 <= sx < w and 0 <= sy < h):
                    continue
                i = sx + sy * w
                if ooz <= zbuf[i]:
                    continue
                nx1 = nx * ca + nz * sa
                nz1 = -nx * sa + nz * ca
                ny2 = ny * cb - nz1 * sb
                nz2 = ny * sb + nz1 * cb
                if nz2 > 0.35:
                    continue
                lum = nx1 * lx + ny2 * ly + nz2 * lz
                lum = 0.08 if lum < 0.08 else lum
                zbuf[i] = ooz
                out[i] = CHARS[int(lum * nchars)]
                col[i] = p * 16 + int(lum * 15)

            top = max(0, (h - len(info_lines)) // 2)
            lines = []
            for r in range(h):
                parts, last = [], None
                for c in range(w):
                    i = c + r * w
                    if out[i] == " ":
                        parts.append(" ")
                        continue
                    if col[i] != last:
                        last = col[i]
                        rr, gg, bb = palette[last // 16]
                        f = 0.35 + 0.65 * (last % 16) / 15
                        parts.append(f"\x1b[38;2;{int(rr * f)};{int(gg * f)};{int(bb * f)}m")
                    parts.append(out[i])
                line = "".join(parts) + "\x1b[0m"
                if show and top <= r < top + len(info_lines):
                    line += "  " + info_lines[r - top] + "\x1b[K"
                else:
                    line += "\x1b[K"
                lines.append(line)
            sys.stdout.write("\x1b[H" + "\n".join(lines))
            sys.stdout.flush()
            spare = 1 / FPS - (time.time() - start - t)
            if spare > 0:
                time.sleep(spare)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[0m\x1b[?25h\n")


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return
    if "--list" in args:
        if shutil.which("fastfetch"):
            subprocess.run(["fastfetch", "--print-logos"])
        else:
            print("spifetch uses fastfetch's logos. Install fastfetch first (Fedora: sudo dnf install fastfetch, Windows: winget install fastfetch).")
        return
    speed = 1.6
    if "--speed" in args:
        try:
            speed = float(args[args.index("--speed") + 1])
        except (IndexError, ValueError):
            pass
    logo = args[args.index("--logo") + 1] if "--logo" in args and args.index("--logo") + 1 < len(args) else None
    show_info = "--no-info" not in args

    osr = os_release()
    distro = (logo or osr.get("ID", "")).lower()
    if distro == "fedorium":
        (points, palette), accent = fedorium_points()
    else:
        res = fastfetch_points(logo)
        if res is None:
            res = text_points(logo or osr.get("NAME") or osr.get("ID") or platform.system())
        (points, palette), accent = res
    title, info = system_info(osr)
    render(points, palette, accent, title, info, speed, show_info)


if __name__ == "__main__":
    main()
